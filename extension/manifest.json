{
  "manifest_version": 3,
  "name": "Twitch Auto Claim Points",
  "version": "2.3.0",
  "description": "Automatically claims Twitch Channel Points bonus chests. Optional chat settings and claim animation.",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles/inject.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitch Auto Claim Points",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.twitch.tv/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*"
      ],
      "matches": [
        "https://*.twitch.tv/*"
      ]
    }
  ]
}
